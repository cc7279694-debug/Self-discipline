<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Raw storage cannot preserve the coordinated snapshot and validation of manual backups.
         Exclude whole domains, including future files and database WAL/SHM/journal sidecars. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <!-- Some Android 12+ implementations ignore allowBackup=false for device transfers. -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
    <!-- Android 16 QPR2+: deny this mode explicitly. No platform-specific-params are declared:
         Mirra has no iOS peer and does not opt in to cross-platform transfers. -->
    <cross-platform-transfer platform="ios">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cross-platform-transfer>
</data-extraction-rules>
