{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mirra:wearable:protocol:1",
  "title": "Mirra read-only companion v1",
  "description": "UTF-8 maximum 4096 bytes. ID, phase ownership, page bounds and Unicode-pair checks are additionally enforced by both codecs.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "HELLO"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "capabilities": {
          "const": [
            "READ_ONLY_SNAPSHOT"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "capabilities"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "HELLO_ACK"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "capabilities": {
          "const": [
            "READ_ONLY_SNAPSHOT"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "streamId",
        "capabilities"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "GET_SNAPSHOT"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "lastSeenSessionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "streamId",
        "lastSeenSessionId"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "SNAPSHOT"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceObservedAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "intentId",
            "sessionId",
            "learningItemId",
            "bookTitle",
            "currentPage",
            "totalPages",
            "firstAction",
            "bookTitleTruncated",
            "firstActionTruncated",
            "segmentType",
            "coverage",
            "monitorAvailability",
            "elapsedMs",
            "remainingMs",
            "timerKind",
            "endType"
          ],
          "properties": {
            "phase": {
              "enum": [
                "IDLE",
                "PREPARING",
                "ACTIVE",
                "SAVING",
                "ENDED"
              ]
            },
            "intentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]{1,80}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sessionId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]{1,80}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "learningItemId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]{1,80}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bookTitle": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "firstAction": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 180
            },
            "bookTitleTruncated": {
              "type": "boolean"
            },
            "firstActionTruncated": {
              "type": "boolean"
            },
            "currentPage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalPages": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "segmentType": {
              "enum": [
                null,
                "FOCUS",
                "DEEP_FOCUS",
                "BREAK",
                "TEMPORARY_ALLOWANCE",
                "DISTRACTION",
                "RECOVERY",
                "UNMONITORED"
              ]
            },
            "coverage": {
              "enum": [
                null,
                "FULL",
                "PARTIAL",
                "NONE"
              ]
            },
            "monitorAvailability": {
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE",
                "UNKNOWN"
              ]
            },
            "elapsedMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "remainingMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "timerKind": {
              "enum": [
                "NONE",
                "PREPARATION_ELAPSED",
                "SESSION_ELAPSED",
                "BREAK_REMAINING",
                "ALLOWANCE_REMAINING",
                "FINAL_SESSION_DURATION"
              ]
            },
            "endType": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            }
          }
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "streamId",
        "sequence",
        "sourceObservedAtUnixMs",
        "body"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "STATUS_ERROR"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "code": {
          "enum": [
            "SOURCE_BUSY",
            "DISABLED",
            "UNSUPPORTED_PROTOCOL",
            "SOURCE_UNAVAILABLE",
            "UNAUTHORIZED",
            "IDENTITY_ERROR"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "code"
      ]
    }
  ]
}
