{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mirra:wearable:protocol:2",
  "title": "Mirra companion v2: bounded learning controls",
  "description": "UTF-8 maximum 4096 bytes. Both codecs additionally enforce valid Unicode, exact action-specific identity, phase ownership, page bounds, and control grant lifetime (1..30000 milliseconds relative to source observation). v1 is a separate immutable read-only protocol.",
