      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "type": {
          "const": "HELLO"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "capabilities": {
          "enum": [
            [
              "READ_ONLY_SNAPSHOT"
            ],
            [
              "READ_ONLY_SNAPSHOT",
              "SESSION_CONTROL"
            ]
          ]
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "capabilities"
      ]
    },
