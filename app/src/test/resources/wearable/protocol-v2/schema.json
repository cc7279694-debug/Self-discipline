              ]
            },
            "allowedActions": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 3,
              "items": {
                "enum": [
                  "START_BREAK",
                  "FINISH_BREAK",
                  "CONFIRM_PREPARATION_AND_START"
