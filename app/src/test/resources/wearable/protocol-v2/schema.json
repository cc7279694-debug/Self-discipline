    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "type": {
          "const": "COMMAND_RESULT"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$"
        },
        "action": {
          "enum": [
            "START_BREAK",
            "FINISH_BREAK",
            "CONFIRM_PREPARATION_AND_START"
          ]
        },
        "code": {
          "enum": [
            "APPLIED",
            "ALREADY_APPLIED",
            "STALE_STATE",
            "REQUIRES_PHONE",
            "DISABLED",
            "UNAUTHORIZED",
            "BUSY",
            "FAILED",
            "RESULT_UNKNOWN"
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "monitorDegraded": {
          "type": "boolean"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "clientInstanceId",
        "requestId",
        "streamId",
        "action",
        "code",
        "sessionId",
        "monitorDegraded"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "monitorDegraded": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "CONFIRM_PREPARATION_AND_START"
              },
              "code": {
                "enum": [
                  "APPLIED",
                  "ALREADY_APPLIED"
                ]
              },
              "sessionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,80}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "APPLIED",
                  "ALREADY_APPLIED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sessionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,80}$"
              }
            }
          }
        }
